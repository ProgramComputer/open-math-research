theorem fixedPrincipalCaps_ledger (slab : Fin 9) :
    2 * scaledIntegerCost (principalLower slab) (principalQLedger slab) * 1000000 +
        100 * principalDyadicScale * linearScale ≤
      fixedPrincipalCaps slab * principalDyadicScale * linearScale := by
  fin_cases slab <;> decide +kernel

theorem rationalPrincipalCost_le_fixed_cap (slab : Fin 9)
    (hledger : qSlabPrefix slab 240 = principalQLedger slab) :
    rationalPrincipalCost slab ≤ (fixedPrincipalCaps slab : ℚ) / 1000000 := by
  apply rationalPrincipalCost_le_integer_certificate
  rw [hledger]
  exact fixedPrincipalCaps_ledger slab

#print axioms fixedPrincipalCaps_ledger
#print axioms rationalPrincipalCost_le_fixed_cap
end OpenMathResearch.LongCycleExcedances
