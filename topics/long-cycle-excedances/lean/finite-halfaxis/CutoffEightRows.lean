      OpenMathResearch.LongCycleExcedances.originalReducedCount n 8 i := by
  apply exactListTable_reads (by decide) coefficientRow _ _ _ n hn i hi
  · intro m hm j _
    interval_cases m <;> rfl
  · intro j hj
    rw [← fastWeight_eq]
    exact (show ∀ j : Fin 32, exactListRead (coefficientRow 8) j = fastWeight j by decide) ⟨j, hj⟩
