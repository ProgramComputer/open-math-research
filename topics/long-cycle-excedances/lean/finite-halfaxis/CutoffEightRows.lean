private theorem weight_snapshot :
    LongCycleFinite.descentCoeffs 7 = [1, 120, 1191, 2416, 1191, 120, 1] := by decide

private def fastWeight (j : ℕ) : ℕ :=
  exactListRead [1, 120, 1191, 2416, 1191, 120, 1] j

private theorem fastWeight_eq : fastWeight = compactCycleWeight 8 := by
  funext j
  simp only [fastWeight, compactCycleWeight, exactListRead]
  rw [show 8 - 1 = 7 from rfl, weight_snapshot]
  have hh : [1, 120, 1191, 2416, 1191, 120, 1] = (List.map Int.toNat ([1, 120, 1191, 2416, 1191, 120, 1] : List ℤ)) := rfl
  rw [hh, List.getElem?_map]
  cases (([1, 120, 1191, 2416, 1191, 120, 1] : List ℤ)[j]?) <;> rfl

